@startuml Fellow4U_Login_Activity
scale 1.5
!define RECTANGLE rectangle
skinparam linetype ortho
skinparam defaultFontSize 14

start
:Người dùng mở ứng dụng;
:Chọn đăng nhập;

repeat
  :Nhập email;
  :Nhập password;

  if (Email hợp lệ?) then (Không)
    :Hiển thị lỗi "Email không hợp lệ";
  else (Có)
    if (Password không rỗng?) then (Không)
      :Hiển thị lỗi "Password không được rỗng";
    else (Có)
      break
    endif
  endif

repeat while (Dữ liệu chưa hợp lệ?) is (Có)

:Nhấn nút "Login";
:Gửi POST /auth/login đến backend;
:Kèm theo {email, password};
:Backend nhận request;

:Backend validate dữ liệu;
if (Email hoặc Password không hợp lệ?) then (Có)
  :Trả lỗi 400 {message};
  :Hiển thị thông báo lỗi;
  :Người dùng sửa;
  repeat
  repeat while (Thử lại?) is (Có)
else (Không)
endif

:Tìm kiếm user trong database;
:So sánh password với mật khẩu đã mã hóa;

if (User tồn tại AND Password đúng?) then (Không)
  :Trả lỗi 401 "Invalid email or password";
  :Hiển thị thông báo lỗi;
  repeat
  repeat while (Thử lại?) is (Có)
else (Có)
endif

:Sinh JWT token (expiresIn: 30d);
:Trả 200 {id, name, email, avatar, token};
:Ứng dụng nhận dữ liệu;

:Lưu token vào Local Storage;
:Lưu user info (id, name, email, avatar);
:Hiển thị thông báo "Đăng nhập thành công!";
:Chuyển đến màn hình chính;

stop

@enduml
