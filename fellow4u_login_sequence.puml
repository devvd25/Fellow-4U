@startuml Fellow4U_Login_Sequence

!define RECTANGLE rectangle
skinparam defaultFontSize 12
skinparam sequenceArrowThickness 2

participant "User" as U
participant "LoginScreen\n(Flutter)" as LS
participant "ApiService\n(HTTP)" as API
participant "Express\nBackend" as BE
participant "SQLite\nDatabase" as DB

U -> LS: Nhập email & password
U -> LS: Nhấn nút "Login"
LS -> LS: Validate dữ liệu local

alt Validate thất bại
  LS -> U: Hiển thị lỗi validate
else Validate thành công
  LS -> API: post(/auth/login, {email, password})
  API -> BE: HTTP POST /auth/login
  BE -> BE: Validate email format & password exists

  alt Dữ liệu không hợp lệ
    BE -> API: 400 Bad Request {message}
    API -> LS: 400 Error
    LS -> U: Hiển thị lỗi "Email không hợp lệ" hoặc "Password bắt buộc"
  else Dữ liệu hợp lệ
    BE -> DB: findOne({email: normalizedEmail})
    DB -> BE: Return user or null

    alt Email không tồn tại hoặc Password sai
      BE -> API: 401 Unauthorized {message: "Invalid email or password"}
      API -> LS: 401 Error
      LS -> U: Hiển thị "Email hoặc mật khẩu sai"
    else Email tồn tại và Password đúng
      BE -> BE: Generate JWT token (expiresIn: 30d)
      BE -> API: 200 OK {id, name, email, avatar, token}
      API -> LS: Response token & user info
      LS -> LS: Save token to Local Storage
      LS -> LS: Save user info (id, name, email, avatar)
      LS -> U: Hiển thị "Đăng nhập thành công!"
      LS -> LS: Navigate to MainScreen
    end
  end
end

@enduml
