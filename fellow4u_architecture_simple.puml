@startuml Fellow4U_Architecture_Simple

skinparam backgroundColor #FFFFFF
skinparam linetype ortho
skinparam componentStyle rectangle

package "Mobile App (Flutter)" {
  component "UI Screens" as UI
  component "Services (API)" as Services
  component "Local Storage" as Storage
  UI --> Services
  Services --> Storage
}

package "Network" {
  component "HTTP REST API" as Network
}

package "Backend (Express)" {
  component "Routes" as Routes
  component "Middleware (Auth)" as Middleware
  component "Controllers" as Controllers
  component "Models" as Models

  Routes --> Middleware
  Middleware --> Controllers
  Controllers --> Models
}

package "Database" {
  component "SQLite" as SQLite
  component "Cloudinary" as Cloud
}

Services --> Network: HTTP Request
Network --> Routes: API Call
Controllers --> SQLite: Query
Controllers --> Cloud: Upload
Network <-- Controllers: Response

@enduml
