@startuml Fellow4U_Architecture_Simple

!define MOBILE_COLOR #E3F2FD
!define BACKEND_COLOR #FFF3E0
!define DATABASE_COLOR #F3E5F5

skinparam backgroundColor #FFFFFF
skinparam linetype ortho

package "📱 FLUTTER MOBILE APP" #MOBILE_COLOR {
  component "UI Screens" as MobileUI [
    Sign In/Up
    Chat, Trips
    Profile, Explore
  ]
  component "Services & API" as MobileServices [
    ApiService
    Auth Service
  ]
  component "Local Storage" as MobileStorage [
    Token, User Info
  ]
}

package "🌐 NETWORK" #E0E0E0 {
  component "HTTP/REST API (JSON)" as Network
}

package "🖥️ EXPRESS.JS BACKEND" #BACKEND_COLOR {
  component "Routes" as Routes [
    /auth
    /api/*
  ]
  component "Middleware" as Middleware [
    JWT Auth
    Upload Cloudinary
  ]
  component "Controllers" as Controllers [
    Auth, Chat
    Trip, Core
  ]
  component "Models (ORM)" as Models [
    Sequelize
  ]
}

package "💾 DATA STORAGE" #DATABASE_COLOR {
  component "SQLite Database" as SQLite [
    Users, Trips
    Messages, Chats
    News, Tours
  ]
  component "Cloudinary" as Cloudinary [
    Image Storage
  ]
}

MobileUI --> MobileServices
MobileServices --> MobileStorage
MobileServices --> Network: HTTP Request

Network --> Routes
Routes --> Middleware
Middleware --> Controllers
Controllers --> Models

Models --> SQLite
Models --> Cloudinary

Controllers --> Network: Response JSON

@enduml
