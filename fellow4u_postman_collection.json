{
  "info": {
    "_postman_id": "fellow4u-api-collection",
    "name": "Fellow4U Backend API",
    "description": "Postman collection test API Fellow4U. Chạy theo thứ tự: Health Check -> Sign Up/Login -> các API có token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00. Health Check",
      "item": [
        {
          "name": "Backend Root",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Backend trả message', function () { pm.expect(pm.response.json()).to.have.property('message'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          },
          "response": []
        }
      ]
    },
    {
      "name": "01. Auth",
      "item": [
        {
          "name": "Sign Up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 hoặc user đã tồn tại', function () { pm.expect([201, 400]).to.include(pm.response.code); });",
                  "const data = pm.response.json();",
                  "if (data.token) { pm.collectionVariables.set('token', data.token); }",
                  "if (data.id) { pm.collectionVariables.set('userId', data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{testUserName}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/signup"
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('Có JWT token', function () { pm.expect(data.token).to.be.a('string').and.not.empty; });",
                  "pm.collectionVariables.set('token', data.token);",
                  "pm.collectionVariables.set('userId', data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "response": []
        },
        {
          "name": "Update Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Tên đã cập nhật', function () { pm.expect(pm.response.json().name).to.eql('Nguyen Van A Updated'); });"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nguyen Van A Updated\",\n  \"phone\": \"0909123456\",\n  \"location\": \"Da Nang, Vietnam\",\n  \"avatar\": \"https://picsum.photos/seed/avatar/300/300\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/update"
          },
          "response": []
        },
        {
          "name": "Login - Invalid Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "response": []
        }
      ]
    },
    {
      "name": "02. Core Data",
      "item": [
        {
          "name": "Get Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('Response là array', function () { pm.expect(data).to.be.an('array'); });",
                  "if (data.length > 0) { pm.collectionVariables.set('participantId', data[0].id); }"
                ]
              }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/users" },
          "response": []
        },
        {
          "name": "Get News",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });", "pm.test('Response là array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"] }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/news" },
          "response": []
        },
        {
          "name": "Get Tours",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });", "pm.test('Response là array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"] }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/tours" },
          "response": []
        }
      ]
    },
    {
      "name": "03. Trips",
      "item": [
        {
          "name": "Create Trip",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "if (data.id) { pm.collectionVariables.set('tripId', data.id); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Du lich Da Nang\",\n  \"location\": \"Da Nang\",\n  \"date\": \"2026-06-15\",\n  \"time\": \"08:00 - 18:00\",\n  \"description\": \"Chuyen di test tu Postman\",\n  \"imageUrl\": \"https://picsum.photos/seed/trip/600/400\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/trips"
          },
          "response": []
        },
        {
          "name": "Get My Trips",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });", "pm.test('Response là array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"] }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/trips"
          },
          "response": []
        },
        {
          "name": "Get Trip Detail",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Status 200 hoặc 404 nếu chưa có tripId', function () { pm.expect([200, 404]).to.include(pm.response.code); });"] }
            }
          ],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/trips/{{tripId}}" },
          "response": []
        }
      ]
    },
    {
      "name": "04. Chat",
      "item": [
        {
          "name": "Create Conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 hoặc 400', function () { pm.expect([201, 400]).to.include(pm.response.code); });",
                  "if (pm.response.code === 201) { const data = pm.response.json(); if (data.id) pm.collectionVariables.set('conversationId', data.id); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participantId\": \"{{participantId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/chat/conversations"
          },
          "response": []
        },
        {
          "name": "Get Conversations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('Response là array', function () { pm.expect(data).to.be.an('array'); });",
                  "if (data.length > 0 && data[0].id) { pm.collectionVariables.set('conversationId', data[0].id); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/chat/conversations"
          },
          "response": []
        },
        {
          "name": "Send Message",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Status 201 hoặc 500 nếu conversationId chưa hợp lệ', function () { pm.expect([201, 500]).to.include(pm.response.code); });"] }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"{{conversationId}}\",\n  \"text\": \"Xin chao tu Postman\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/chat/messages"
          },
          "response": []
        },
        {
          "name": "Get Messages",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Status 200 hoặc 500 nếu conversationId chưa hợp lệ', function () { pm.expect([200, 500]).to.include(pm.response.code); });"] }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/chat/messages?conversationId={{conversationId}}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "05. Upload",
      "item": [
        {
          "name": "Upload Image",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Status 200 hoặc lỗi cấu hình Cloudinary', function () { pm.expect([200, 400, 500]).to.include(pm.response.code); });"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": "{{baseUrl}}/api/upload"
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('testEmail')) {",
          "  pm.collectionVariables.set('testEmail', `test_${Date.now()}@fellow4u.local`);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "participantId", "value": "", "type": "string" },
    { "key": "conversationId", "value": "", "type": "string" },
    { "key": "tripId", "value": "", "type": "string" },
    { "key": "testUserName", "value": "Nguyen Van A", "type": "string" },
    { "key": "testEmail", "value": "", "type": "string" },
    { "key": "testPassword", "value": "123456", "type": "string" }
  ]
}
