@startuml Fellow4U_EditProfile_Activity
scale 1.5
!define RECTANGLE rectangle
skinparam linetype ortho
skinparam defaultFontSize 14

start
:Người dùng vào màn hình "Edit Profile";
:Tải thông tin user từ Local Storage;
:Hiển thị các trường (Name, Phone, Location, Avatar...);

:Người dùng thay đổi thông tin;

if (Cần thay đổi ảnh đại diện?) then (Có)
  :Nhấn nút chọn ảnh;
  :Mở dialog "Chọn ảnh từ thư viện";
  :Người dùng chọn ảnh;

  if (Ảnh hợp lệ?) then (Không)
    :Hiển thị lỗi "Định dạng hoặc kích thước không hợp lệ";
    repeat
    repeat while (Chọn ảnh khác?) is (Có)
  else (Có)
  endif

  :Gửi POST /api/upload;
  :Gửi file ảnh (multipart/form-data);
  :Backend nhận file;
  :Validate file (size, type);
  :Upload lên Cloudinary;

  if (Upload thành công?) then (Có)
    :Nhận URL ảnh từ Cloudinary;
    :Hiển thị ảnh preview mới;
  else (Không)
    :Trả lỗi 500 "Upload failed";
    :Hiển thị thông báo lỗi;
  endif
else (Không)
endif

:Nhấn nút "SAVE";

if (Dữ liệu hợp lệ phía client?) then (Không)
  :Hiển thị lỗi validate;
  :Người dùng sửa;
  repeat
  repeat while (Dữ liệu còn lỗi?) is (Có)
else (Có)
endif

:Gửi PATCH /auth/update;
:Kèm theo {name, phone, location, avatar, password, JWT token};
:Backend nhận request;

if (JWT token hợp lệ?) then (Không)
  :Trả lỗi 401 "Không được phép";
  :Hiển thị thông báo lỗi;
  stop
else (Có)
endif

:Backend validate dữ liệu;
if (Có field không hợp lệ?) then (Có)
  :Trả lỗi 400 {message};
  :Hiển thị thông báo lỗi;
  stop
else (Không)
endif

if (Name được gửi AND Name < 2 ký tự?) then (Có)
  :Trả lỗi 400 "Name must be at least 2 characters";
  :Hiển thị thông báo lỗi;
  stop
else (Không)
endif

if (Password được gửi AND Password < 6 ký tự?) then (Có)
  :Trả lỗi 400 "Password must be at least 6 characters";
  :Hiển thị thông báo lỗi;
  stop
else (Không)
endif

:Tìm user trong database;

if (User không tồn tại?) then (Có)
  :Trả lỗi 404 "User not found";
  :Hiển thị thông báo lỗi;
  stop
else (Không)
endif

:Cập nhật các field được gửi;
:Lưu vào database SQLite;

if (Lưu thành công?) then (Có)
  :Trả 200 {id, name, email, phone, location, avatar};
  :Ứng dụng nhận dữ liệu mới;
  :Cập nhật Local Storage;
  :Hiển thị thông báo "Cập nhật hồ sơ thành công";
  :Quay lại màn hình hồ sơ;
else (Không)
  :Trả lỗi 500 "Lỗi hệ thống";
  :Hiển thị thông báo "Cập nhật thất bại";
  stop
endif

stop

@enduml
