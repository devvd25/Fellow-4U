@startuml Fellow4U_SignUp_Activity
!define RECTANGLE rectangle
skinparam linetype ortho
skinparam defaultFontSize 14
scale 1.5

start
:Người dùng mở ứng dụng;
:Chọn đăng ký tài khoản;

repeat
  :Nhập name, email, password;
  :Nhập confirm password;

  if (Name >= 2 ký tự?) then (Không)
    :Hiển thị lỗi "Name phải >= 2 ký tự";
  else (Có)
    if (Email hợp lệ?) then (Không)
      :Hiển thị lỗi "Email không hợp lệ";
    else (Có)
      if (Password >= 6 ký tự?) then (Không)
        :Hiển thị lỗi "Password phải >= 6 ký tự";
      else (Có)
        if (Confirm password == Password?) then (Không)
          :Hiển thị lỗi "Confirm password không khớp";
        else (Có)
          break
        endif
      endif
    endif
  endif

repeat while (Dữ liệu còn lỗi?) is (Có)

:Gửi POST /auth/signup;
:Kèm theo {name, email, password};
:Backend nhận request;

:Backend validate dữ liệu;
if (Dữ liệu không hợp lệ?) then (Có)
  :Trả lỗi 400 {message};
  :Hiển thị thông báo lỗi;
  :Người dùng sửa;
  repeat
  repeat while (Thử lại?) is (Có)
else (Không)
endif

:Kiểm tra email đã tồn tại;
if (Email tồn tại?) then (Có)
  :Trả lỗi 400 "User already exists";
  :Hiển thị thông báo;
  :Người dùng thử email khác;
  repeat
  repeat while (Thử lại?) is (Có)
else (Không)
endif

:Tạo user mới với password đã mã hóa;
:Lưu vào database;

if (Lưu thành công?) then (Có)
  :Sinh JWT token (expiresIn: 30d);
  :Trả 201 {id, name, email, token};
  :Ứng dụng nhận dữ liệu;
  :Lưu token vào Local Storage;
  :Lưu user info (id, name, email);
  :Hiển thị thông báo "Đăng ký thành công!";
  :Chuyển đến màn hình chính;
else (Không)
  :Trả lỗi 500;
  :Hiển thị "Lỗi hệ thống";
  stop
endif

stop

@enduml

