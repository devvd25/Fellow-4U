@startuml Fellow4U_SendMessage_Sequence

!define RECTANGLE rectangle
skinparam defaultFontSize 12
skinparam sequenceArrowThickness 2

participant "User" as U
participant "ChatScreen\n(Flutter)" as CS
participant "ChatService\n(HTTP)" as HTTP
participant "Express\nBackend" as BE
participant "SQLite\nDatabase" as DB

U -> CS: Nhập nội dung tin nhắn
U -> CS: Nhấn nút "Gửi"
CS -> CS: Validate nội dung (không rỗng)

alt Validate thất bại
  CS -> U: Hiển thị lỗi "Tin nhắn không được rỗng"
else Validate thành công
  CS -> HTTP: post(/api/chat/messages, {conversationId, text, JWT token})
  HTTP -> BE: HTTP POST /api/chat/messages
  BE -> BE: Verify JWT token (via authMiddleware)

  alt Token không hợp lệ
    BE -> HTTP: 401 Unauthorized
    HTTP -> CS: 401 Error
    CS -> U: Hiển thị "Phiên đăng nhập hết hạn"
  else Token hợp lệ
    BE -> DB: Create message {text, conversationId, senderId}
    DB -> BE: Return created message hoặc error

    alt Message created thành công
      BE -> HTTP: 201 Created {id, text, conversationId, senderId, createdAt}
      HTTP -> CS: 201 Response với message data
      CS -> CS: Thêm message vào danh sách
      CS -> CS: Clear input field
      CS -> CS: Scroll to bottom
      CS -> U: Hiển thị tin nhắn mới
    else Message creation thất bại
      BE -> HTTP: 500 Server Error {message: error description}
      HTTP -> CS: 500 Error
      CS -> U: Hiển thị "Lỗi hệ thống, gửi tin nhắn thất bại"
    end
  end
end

@enduml
